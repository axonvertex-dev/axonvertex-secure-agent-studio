# Never commit the real .env.runtime-adapter.
AXV_REGISTRY_URL=http://127.0.0.1:18781
AXV_REGISTRY_ADMIN_TOKEN=

# Runtime endpoints may normally use these defaults; override only when topology changes.
AXV_RUNTIME_GEMMA_NODE_A_URL=http://100.82.103.57:11433/v1
AXV_RUNTIME_ANTARES_NODE_B_URL=http://127.0.0.1:18184/v1
AXV_RUNTIME_FOUNDATION_NODE_C_URL=http://100.76.212.84:18183/v1

# Secret values remain local to the adapter process.
AXV_RUNTIME_GEMMA_NODE_A_API_KEY=
AXV_RUNTIME_ANTARES_NODE_B_API_KEY=
AXV_RUNTIME_FOUNDATION_NODE_C_API_KEY=
