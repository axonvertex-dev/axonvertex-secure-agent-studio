GEMMA_MODEL=gemma-4-12b-it-qat
GEMMA_API_KEY=
GEMMA_CONTEXT_LIMIT=131072


# ------------------------------------------------------------
# NODE B — Antares 1B / llama.cpp
# Mandatory baseline security intelligence layer
# ------------------------------------------------------------

ANTARES_BASE_URL=http://100.99.149.21:11433/v1
ANTARES_MODEL=
ANTARES_API_KEY=
ANTARES_CONTEXT_LIMIT=65536


# ------------------------------------------------------------
# NODE C — Foundation Sec 8B
# Dedicated security reasoning model
# No direct tool authority
# ------------------------------------------------------------

FOUNDATION_SEC_BASE_URL=http://100.76.212.84:11433/v1
FOUNDATION_SEC_MODEL=
FOUNDATION_SEC_API_KEY=
FOUNDATION_SEC_CONTEXT_LIMIT=32768


# ============================================================
# Context Budget Profiles
# Used primarily for Gemma / large-context investigation
# ============================================================

CONTEXT_PROFILE_32K=32768
CONTEXT_PROFILE_64K=65536
CONTEXT_PROFILE_96K=98304
